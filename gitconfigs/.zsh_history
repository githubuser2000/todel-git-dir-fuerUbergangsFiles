: 1759816419:0;output_dir="/home/alex/Eigene-Dateien/data/Eigene-Dateien/Musik/music2/EDM/" \
\
# Schleife über alle Videodateien (z. B. mp4, mkv, avi, mov …)\
for file in *.{mp4,mkv,avi,mov,flv,webm}; do\
 # Prüfen ob Datei existiert (um "*.mp4" literal zu vermeiden)\
 [ -e "$file" ] || continue \
 \
 # Dateiname ohne Erweiterung extrahieren\
 base_name="${file%.*}"\
 \
 # Ausgabe-Zieldatei festlegen\
 output_file="$output_dir/$base_name.wav"\
 \
 # ffmpeg Befehl ausführen \
 ffmpeg -i "$file" -vn -acodec pcm_s16le -ar 44100 -ac 2 "$output_file"\
done
