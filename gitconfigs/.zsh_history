# Eingabedatei\
input_file="input.txt"\
# Ausgabedatei\
output_file="output.csv"\
\
# Sicherstellen, dass die Ausgabedatei leer ist\
> "$output_file"\
\
# Zeilenweise durch die Eingabedatei gehen\
while IFS= read -r line; do\
  if [[ "$line" == *";"* ]]; then\
    echo "\"$line\"" >> "$output_file"\
  else\
    echo "$line" >> "$output_file"\
  fi\
done < "$input_file"" > zwei.sh
